<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque, fullscreen, black: covers whatever is behind it (e.g. a playing reel). -->
    <style name="Theme.AppBoundary.Alert" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Vault: dark, calm, edge to edge colors. -->
    <style name="Theme.AppBoundary.Vault" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/vault_bg</item>
        <item name="android:statusBarColor">@color/vault_bg</item>
        <item name="android:navigationBarColor">@color/vault_bg</item>
        <item name="android:textColorPrimary">@color/vault_text</item>
    </style>

    <!-- Base for the dotted Vault.* styles below (a dotted name implies this parent). -->
    <style name="Vault" />

    <style name="Vault.Card">
        <item name="android:background">@drawable/bg_vault_card</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Vault.CardTitle">
        <item name="android:textColor">@color/vault_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Vault.Body">
        <item name="android:textColor">@color/vault_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Vault.NavItem">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/vault_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Vault.Button">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/vault_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_btn_tonal</item>
    </style>

    <style name="Vault.Button.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>

    <style name="Vault.Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/vault_text</item>
        <item name="android:textColorHint">@color/vault_text_dim</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Dialogs: dark rounded card instead of the grey stock box. -->
    <style name="Vault.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/vault_card</item>
        <item name="android:colorAccent">@color/vault_accent</item>
        <item name="android:textColorPrimary">@color/vault_text</item>
        <item name="android:textColorSecondary">@color/vault_text_dim</item>
        <item name="android:textColorAlertDialogListItem">@color/vault_text</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
