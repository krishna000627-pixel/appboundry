<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/ivSheetIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:tint="@color/vault_text" />

    <TextView
        android:id="@+id/tvSheetName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/vault_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvSheetCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vault_media_check"
        android:textColor="@color/vault_accent"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
