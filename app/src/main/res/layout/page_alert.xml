<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageAlert"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Live preview -->
        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_alert_preview_label" />

            <TextView
                android:id="@+id/tvPrevTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/vault_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrevMsg"
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Vault.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_alert_title" />

            <EditText
                android:id="@+id/etTitle"
                style="@style/Vault.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etMessage"
                style="@style/Vault.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <TextView
                android:id="@+id/tvAlertCounts"
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp" />

            <TextView
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vault_alert_hint" />

            <TextView
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/vault_alert_hint_dg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReset"
                    style="@style/Vault.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/vault_reset" />

                <TextView
                    android:id="@+id/btnPreview"
                    style="@style/Vault.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/vault_preview" />

                <TextView
                    android:id="@+id/btnSave"
                    style="@style/Vault.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/vault_save" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
