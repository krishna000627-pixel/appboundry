<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageUnlock"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUnlockSummary"
                style="@style/Vault.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/vault_unlock_summary_desc" />
        </LinearLayout>

        <!-- Tap and hold -->
        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_m_taphold_title" />

                <Switch
                    android:id="@+id/swTapHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vault_m_taphold_desc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vault.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_taps"
                    android:textColor="@color/vault_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnTapsMinus"
                    style="@style/Vault.Button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="-"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvTaps"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/vault_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTapsPlus"
                    style="@style/Vault.Button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume code -->
        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_m_volume_title" />

                <Switch
                    android:id="@+id/swVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vault_m_volume_desc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVolumeCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/vault_accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVolumeSet"
                    style="@style/Vault.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/vault_set_pattern" />
            </LinearLayout>
        </LinearLayout>

        <!-- Corner code -->
        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_m_corner_title" />

                <Switch
                    android:id="@+id/swCorner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vault_m_corner_desc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCornerCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/vault_accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCornerSet"
                    style="@style/Vault.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/vault_set_pattern" />
            </LinearLayout>

            <!-- Pad shown only while setting the code: one square per screen quarter -->
            <LinearLayout
                android:id="@+id/llCornerPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pad1"
                        style="@style/Vault.Button"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="&#8598;"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/pad2"
                        style="@style/Vault.Button"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="&#8599;"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pad3"
                        style="@style/Vault.Button"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="&#8601;"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/pad4"
                        style="@style/Vault.Button"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_margin="4dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="&#8600;"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Two finger hold -->
        <LinearLayout
            style="@style/Vault.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_m_two_title" />

                <Switch
                    android:id="@+id/swTwoFinger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <TextView
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vault_m_two_desc" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
