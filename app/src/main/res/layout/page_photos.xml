<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pagePhotos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:visibility="gone">

    <!-- All files access (shown only while it is off) -->
    <LinearLayout
        android:id="@+id/cardFiles"
        style="@style/Vault.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Vault.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_files_title" />

        <TextView
            style="@style/Vault.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vault_files_desc" />

        <TextView
            android:id="@+id/btnGrantFiles"
            style="@style/Vault.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="@string/vault_files_grant" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMediaCount"
        style="@style/Vault.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <!-- Three tabs: All / Photos / Videos, and sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAll"
            style="@style/Vault.NavItem"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabPhotos"
            style="@style/Vault.NavItem"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabVideos"
            style="@style/Vault.NavItem"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSort"
            style="@style/Vault.NavItem"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="@color/vault_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMediaHint"
        style="@style/Vault.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="@string/vault_media_hint"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gvMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="4dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="3"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="4dp" />

        <TextView
            android:id="@+id/tvMediaEmpty"
            style="@style/Vault.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/vault_media_empty" />
    </FrameLayout>

    <!-- Multi-select actions -->
    <LinearLayout
        android:id="@+id/llSelectBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelCount"
            style="@style/Vault.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelAll"
            style="@style/Vault.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:text="@string/vault_sel_all"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSelMove"
            style="@style/Vault.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:text="@string/vault_sel_move"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSelRestore"
            style="@style/Vault.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:text="@string/vault_sel_restore"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSelDelete"
            style="@style/Vault.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:text="@string/vault_media_delete"
            android:textSize="13sp"
            android:textColor="@color/vault_danger" />

        <TextView
            android:id="@+id/btnSelCancel"
            style="@style/Vault.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:singleLine="true"
            android:text="@string/vault_media_cancel"
            android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
