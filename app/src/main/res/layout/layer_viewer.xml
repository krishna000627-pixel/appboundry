<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerLayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:visibility="gone">

    <com.appboundary.MediaPager
        android:id="@+id/viewerPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top controls -->
    <LinearLayout
        android:id="@+id/viewerTop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="top|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnViewerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_viewer_btn"
            android:clickable="true"
            android:contentDescription="@string/vault_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvViewerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/vault_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Play / pause (videos only) -->
    <TextView
        android:id="@+id/btnPlay"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_circle"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/vault_media_play"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:visibility="gone" />

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/viewerBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/llVideoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/seekVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/vault_accent"
                android:thumbTint="@color/vault_accent" />

            <TextView
                android:id="@+id/tvVideoTime"
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/vault_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvViewerInfo"
            style="@style/Vault.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/vault_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnViewerRestore"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_viewer_btn"
                android:clickable="true"
                android:contentDescription="@string/vault_media_restore"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_photos" />

            <ImageView
                android:id="@+id/btnViewerFolder"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_viewer_btn"
                android:clickable="true"
                android:contentDescription="@string/vault_folder_add_to"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_folder" />

            <ImageView
                android:id="@+id/btnViewerDelete"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_viewer_btn"
                android:clickable="true"
                android:contentDescription="@string/vault_media_delete"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_delete"
                android:tint="@color/vault_danger" />
        </LinearLayout>
    </LinearLayout>

    <!-- Add to folder: translucent sheet that slides up over the picture -->
    <FrameLayout
        android:id="@+id/sheetLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheetPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/vault_folder_add_to"
                android:textColor="@color/vault_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/sheetScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llSheetList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
