<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_bg">

    <!-- ===== PIN gate ===== -->
    <ScrollView
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvGateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/vault_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGateSub"
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/keypad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvForgot"
                style="@style/Vault.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/vault_pin_forgot"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Vault ===== -->
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_title"
                        android:textColor="@color/vault_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Vault.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_subtitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnLock"
                    style="@style/Vault.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/vault_lock" />
            </LinearLayout>

            <!-- Accessibility warning -->
            <LinearLayout
                android:id="@+id/cardAccess"
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Vault.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_access_off"
                    android:textColor="@color/vault_danger" />

                <TextView
                    android:id="@+id/btnAccess"
                    style="@style/Vault.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/vault_access_fix" />
            </LinearLayout>

            <!-- Focus mode -->
            <LinearLayout
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Vault.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_focus_title" />

                    <TextView
                        android:id="@+id/tvFocusState"
                        style="@style/Vault.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <!-- Blocked apps -->
            <LinearLayout
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Vault.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vault_blocked_title" />

                    <TextView
                        android:id="@+id/btnAddApp"
                        style="@style/Vault.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/vault_add_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llBlocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvBlockedEmpty"
                    style="@style/Vault.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vault_blocked_empty" />
            </LinearLayout>

            <!-- Alert screen text -->
            <LinearLayout
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_alert_title" />

                <EditText
                    android:id="@+id/etTitle"
                    style="@style/Vault.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etMessage"
                    style="@style/Vault.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />

                <TextView
                    style="@style/Vault.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/vault_alert_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnReset"
                        style="@style/Vault.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/vault_reset" />

                    <TextView
                        android:id="@+id/btnPreview"
                        style="@style/Vault.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/vault_preview" />

                    <TextView
                        android:id="@+id/btnSave"
                        style="@style/Vault.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/vault_save" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick unlock -->
            <LinearLayout
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_unlock_title" />

                <TextView
                    style="@style/Vault.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/vault_unlock_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Vault.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vault_taps"
                        android:textColor="@color/vault_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnTapsMinus"
                        style="@style/Vault.Button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="-"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTaps"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/vault_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTapsPlus"
                        style="@style/Vault.Button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Security -->
            <LinearLayout
                style="@style/Vault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Vault.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_security_title" />

                <TextView
                    android:id="@+id/btnChangePin"
                    style="@style/Vault.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/vault_change_pin" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                style="@style/Vault.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
