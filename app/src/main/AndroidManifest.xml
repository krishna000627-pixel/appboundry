<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- All files access: lets the vault delete originals directly and restore files. Asked from inside the vault. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Short buzz when the blocker screen is unlocked. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Needed to resolve app names/icons for the blocked list and the app picker (API 30+). -->
    <queries>
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <!-- No LAUNCHER category anywhere: no app-drawer icon. -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AppBoundary.Alert" />

        <!-- Secret vault: opened only by long-pressing the Quick Settings tile. PIN protected. -->
        <activity
            android:name=".VaultActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/vault_label"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppBoundary.Vault"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Streams a hidden photo/video to the app picked in the share sheet. Not exported: only
             the app that was handed a one-off, expiring, read-only link can open it. -->
        <provider
            android:name=".VaultShareProvider"
            android:authorities="com.appboundary.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".BoundaryAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

    </application>
</manifest>
